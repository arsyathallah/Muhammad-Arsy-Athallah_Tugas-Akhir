# =============================================================================
# Contoh konfigurasi environment — salin ke .env lalu sesuaikan.
#   cp .env.example .env
# =============================================================================

# --- Dataset --------------------------------------------------------------
# Sumber dataset: "amazon" (HuggingFace) atau "movielens"
DATASET_SOURCE=amazon

# --- MongoDB Sharded Cluster ----------------------------------------------
# Aplikasi cukup terhubung ke mongos router (entry point cluster).
MONGODB_URI=mongodb://localhost:37017
MONGODB_DATABASE=recommendation_system

# Timeout koneksi (milidetik)
MONGODB_CONNECT_TIMEOUT_MS=15000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=15000

# Metadata cluster (informasional, dipakai untuk monitoring/diagnostik)
MONGODB_CLUSTER_NAME=recommendation_mongodb_cluster
# Daftar node host: mongos, shard1, shard2 (sesuai port-mapping docker-compose)
# Port 37xxx dipakai agar tidak konflik dengan mongod lokal Windows (27017)
MONGODB_NODES=localhost:37017,localhost:37018,localhost:37020

# --- Apache Spark ---------------------------------------------------------
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=8g
SPARK_EXECUTOR_MEMORY=4g

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
